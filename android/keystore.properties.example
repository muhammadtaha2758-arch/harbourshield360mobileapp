# Copy to keystore.properties and fill in after generating your release keystore.
# Generate keystore (from android/app):
#   keytool -genkeypair -v -storetype PKCS12 -keystore harbourshield360-release.keystore -alias harbourshield360-release -keyalg RSA -keysize 2048 -validity 10000
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=harbourshield360-release
storeFile=harbourshield360-release.keystore
